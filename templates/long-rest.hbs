<div class="stress-rest-form">
    <div class="vault-banner-container">
        <div class="vault-banner-img"></div>
        <div class="vault-title">{{localize "STRESS.Dialog.LongRest"}}</div>
    </div>

    <input type="hidden" name="foodId">
    <input type="hidden" name="drinkId">
    <input type="hidden" name="healId">
    <input type="hidden" name="environment" value="0">

    <div class="rest-body">
        <div class="rest-meters">
            <div class="meter-group">
                <div class="label roboto-condensed-upper"><span>{{localize "STRESS.Hud.HP"}}</span></div>
                <div class="meter progress hit-points meter-lg" role="meter" aria-valuemin="0" aria-valuenow="{{hpVal}}" aria-valuemax="{{hpMax}}" style="--bar-percentage: {{hpPercent}}%">
                    <div class="label"><span class="value">{{hpVal}}</span><span class="separator">/</span><span class="max">{{hpMax}}</span></div>
                </div>
            </div>
            <div class="meter-group stress-meter-group">
                <div class="label roboto-condensed-upper"><span>{{localize "STRESS.Sheet.Label"}}</span></div>
                <div class="meter progress stress-meter meter-lg" role="meter" aria-valuemin="0" aria-valuenow="{{stressVal}}" aria-valuemax="{{maxStress}}" style="--bar-percentage: {{stressPercent}}%" data-tooltip="{{stressTooltip}}">
                    <div class="label"><span class="value">{{stressVal}}</span><span class="separator">/</span><span class="max">{{maxStress}}</span></div>
                </div>
            </div>
            <div class="meter-group">
                <div class="label roboto-condensed-upper"><span>{{localize "STRESS.Hud.Exhaustion"}}</span></div>
                <div class="pips rest-pips" role="meter" aria-valuemin="0" aria-valuenow="{{exhaustVal}}" aria-valuemax="{{maxExhaustion}}" data-tooltip="{{exhaustVal}} / {{maxExhaustion}}">
                    {{#each exhaustPips}}<span class="pip {{#if this}}filled{{/if}}"></span>{{/each}}
                </div>
            </div>
        </div>

        {{#if useEnvironment}}
        <section class="rest-section">
            <h4 class="rest-section-title roboto-condensed-upper"><i class="fas fa-location-dot"></i> {{localize "STRESS.Category.Environment"}}</h4>
            {{#if gmEnvironment}}
            {{!-- Locked: set by the GM --}}
            <div class="custom-select-wrapper rest-env-select locked" data-tooltip="{{localize "STRESS.Env.SetByGMHint"}}" aria-disabled="true">
                <div class="custom-select-trigger"><span>{{campEnv.icon}} {{campEnv.label}} · {{campEnv.dcLabel}}</span><i class="fa-solid fa-lock"></i></div>
            </div>
            {{else}}
            <div class="custom-select-wrapper rest-env-select" data-input="environment">
                {{#each envOptions}}{{#if selected}}<div class="custom-select-trigger" data-action="toggleSelect"><span>{{icon}} {{label}} · {{dcLabel}}</span></div>{{/if}}{{/each}}
                <div class="custom-options">
                    {{#each envOptions}}
                    <span class="custom-option {{#if selected}}selected{{/if}}" data-action="selectOption" data-value="{{dc}}" data-label="{{label}}">{{icon}} {{label}} · {{dcLabel}}</span>
                    {{/each}}
                </div>
            </div>
            {{/if}}
        </section>
        {{/if}}

        <section class="rest-section">
            <h4 class="rest-section-title roboto-condensed-upper"><i class="fas fa-utensils"></i> {{localize "STRESS.Category.Food"}}</h4>
            <div class="rest-tiles">
                {{> stress-rest-tile input="foodId" value="" icon="fa-solid fa-xmark" title=(localize "STRESS.Inventory.Nothing") selected=true}}
                {{#each foodItems}}{{> stress-rest-tile input="foodId" value=id title=name}}{{/each}}
                {{#each foodBuyOptions}}{{> stress-rest-tile input="foodId" icon="fa-solid fa-utensils" title=label meta=priceText}}{{/each}}
            </div>
        </section>

        <section class="rest-section">
            <h4 class="rest-section-title roboto-condensed-upper"><i class="fas fa-glass-water"></i> {{localize "STRESS.Category.Drink"}}</h4>
            <div class="rest-tiles">
                {{> stress-rest-tile input="drinkId" value="" icon="fa-solid fa-xmark" title=(localize "STRESS.Inventory.Nothing") selected=true}}
                {{#each drinkItems}}{{> stress-rest-tile input="drinkId" value=id title=name}}{{/each}}
                {{#each drinkBuyOptions}}{{> stress-rest-tile input="drinkId" icon="fa-solid fa-wine-glass" title=label meta=priceText}}{{/each}}
            </div>
        </section>

        {{#if useHealItems}}
        <section class="rest-section">
            <h4 class="rest-section-title roboto-condensed-upper"><i class="fas fa-heart"></i> {{localize "STRESS.Category.Heal"}}</h4>
            <div class="rest-tiles">
                {{> stress-rest-tile input="healId" value="" icon="fa-solid fa-xmark" title=(localize "STRESS.Inventory.Nothing") selected=true}}
                {{#each healItems}}{{> stress-rest-tile input="healId" value=id title=name}}{{/each}}
            </div>
        </section>
        <p class="rest-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "STRESS.Msg.HealerReqWarningLong"}}</p>
        {{/if}}
    </div>

    <footer class="rest-footer">
        <button type="submit" class="btn-gold"><i class="fas fa-campground"></i> {{localize "STRESS.Button.LongRest"}}</button>
    </footer>
</div>
